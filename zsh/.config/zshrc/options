# -----------------------------------------------------
# OPTIONS
# -----------------------------------------------------

# -----------------------------------------------------
# History
# -----------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history extended_history
setopt hist_ignore_dups hist_ignore_space

# -----------------------------------------------------
# General
# -----------------------------------------------------
setopt auto_cd interactive_comments

# -----------------------------------------------------
# Completion
# -----------------------------------------------------
zmodload zsh/complist
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# -----------------------------------------------------
# Key bindings (emacs, like bash)
# -----------------------------------------------------
bindkey -e
bindkey '^[[H'    beginning-of-line
bindkey '^[OH'    beginning-of-line
bindkey '^[[F'    end-of-line
bindkey '^[OF'    end-of-line
bindkey '^[[3~'   delete-char
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^H'      backward-kill-word

# Esc Esc: toggle sudo in front of the line (or the last command)
_sudo_toggle() {
    if [[ -z $BUFFER ]]; then
        BUFFER=$(fc -ln -1)
        CURSOR=$#BUFFER
    fi
    if [[ $BUFFER == "sudo "* ]]; then
        BUFFER=${BUFFER#sudo }
        (( CURSOR = CURSOR > 5 ? CURSOR - 5 : 0 ))
    else
        BUFFER="sudo $BUFFER"
        (( CURSOR += 5 ))
    fi
}
zle -N _sudo_toggle
bindkey '\e\e' _sudo_toggle

# Ctrl+O: copy the current line to the clipboard
_copy_buffer() {
    print -rn -- $BUFFER | wl-copy
    zle -M "Copied to clipboard"
}
zle -N _copy_buffer
bindkey '^O' _copy_buffer

# -----------------------------------------------------
# FZF (CTRL R history, CTRL T files, ALT C cd)
# -----------------------------------------------------
source <(fzf --zsh)
