# -----------------------------------------------------
# Load modular configuration. Order matters! 
# -----------------------------------------------------
source ~/.config/zshrc/init 
source ~/.config/zshrc/options 
source ~/.config/zshrc/prompt 
source ~/.config/zshrc/aliases 
source ~/.config/zshrc/autostart 
source ~/.config/zshrc/plugins
